; Harmonia Virtual Audio. Derived from Microsoft's MIT-licensed SysVAD INF.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/31/2026,0.1.0.0
CatalogFile=HarmoniaVirtualAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Harmonia,NT$ARCH$.10.0...22621
[Harmonia.NT$ARCH$.10.0...22621]
%DeviceName%=HarmoniaDevice,ROOT\HarmoniaVirtualAudio

[SourceDisksNames]
1=%DeviceName%,,,
[SourceDisksFiles]
HarmoniaVirtualAudio.sys=1
[DestinationDirs]
Harmonia.Copy=13
[Harmonia.Copy]
HarmoniaVirtualAudio.sys

[HarmoniaDevice.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Harmonia.Copy
AddReg=Harmonia.Device.AddReg
[Harmonia.Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,HarmoniaVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[HarmoniaDevice.NT.Interfaces]
AddInterface=%Audio%,HarmoniaWave,Harmonia.Wave
AddInterface=%Render%,HarmoniaWave,Harmonia.Wave
AddInterface=%Realtime%,HarmoniaWave,Harmonia.Wave
AddInterface=%Audio%,HarmoniaTopology,Harmonia.Topology
AddInterface=%Topology%,HarmoniaTopology,Harmonia.Topology
[Harmonia.Wave]
AddReg=Harmonia.Wave.AddReg
[Harmonia.Wave.AddReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
[Harmonia.Topology]
AddReg=Harmonia.Topology.AddReg
[Harmonia.Topology.AddReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

[HarmoniaDevice.NT.Services]
AddService=HarmoniaVirtualAudio,0x00000002,Harmonia.Service
[Harmonia.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\HarmoniaVirtualAudio.sys
[HarmoniaDevice.NT.HW]
AddReg=Harmonia.Hardware
[Harmonia.Hardware]
HKR,,DeviceType,0x10001,0x1D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[HarmoniaDevice.NT.Wdf]
KmdfService=HarmoniaVirtualAudio,Harmonia.Wdf
[Harmonia.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

