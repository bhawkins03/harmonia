<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/harmonia.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="VirtualAudio/**/*.cs" />
    <Compile Remove="MainForm.cs" />
    <Compile Remove="AudioEngine.cs" />
    <Compile Remove="SpeakerDiagnostics.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="Assets/harmonia-logo.png" />
  </ItemGroup>
  <Target Name="GenerateHarmoniaIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)\scripts\Generate-LiteIcon.ps1&quot;" />
  </Target>
</Project>
