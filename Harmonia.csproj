<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/harmonia.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="VirtualAudio/**/*.cs" />
    <Compile Remove="Suite/**/*.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="Assets/harmonia-logo.png" />
  </ItemGroup>
  <PropertyGroup Condition="'$(LiteEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);HARMONIA_LITE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LiteEdition)' == 'true'">
    <Compile Remove="Suite*.cs" />
    <Compile Remove="MainForm.cs" />
    <Compile Remove="AudioEngine.cs" />
    <Compile Remove="SpeakerDiagnostics.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(LiteEdition)' != 'true'">
    <ProjectReference Include="Suite/Core/Harmonia.Suite.Core.csproj" />
    <Compile Remove="LiteForm.cs" />
    <Compile Remove="LiteStereoEngine.cs" />
    <Compile Remove="LiteUpdates.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(LiteEdition)' != 'true'">
    <Version Condition="'$(LiteEdition)' != 'true'">0.3.0</Version><AssemblyVersion>$(Version).0</AssemblyVersion>
  </PropertyGroup>
  <Target Name="GenerateHarmoniaIcon" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)\scripts\Generate-LiteIcon.ps1&quot;" />
  </Target>
</Project>
